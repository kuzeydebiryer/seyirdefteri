rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bir kullanıcının bir topluluğun kurucusu veya moderatörü olup olmadığını
    // kontrol eder — Topluluklar/Etkinlikler/İstekler kurallarında tekrar
    // tekrar kullanılıyor. Moderatör rolü opsiyonel bir alan olduğundan
    // .get('rol','') ile güvenli okunuyor (alan hiç yoksa hata vermesin diye).
    function topluluklaYoneticiMi(topluluklId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/topluluklar/$(topluluklId)).data.kurucuId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/topluluklar/$(topluluklId)/uyeler/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/topluluklar/$(topluluklId)/uyeler/$(request.auth.uid)).data.get('rol', '') == 'moderator'
        )
      );
    }

    // Site geneli yönetici kontrolü — dusunceHavuzu'ndaki tek seferlik
    // kontrolle aynı mantık, artık birden fazla yerde (platform verisi,
    // favori/yönetmen silme gibi paylaşılan/yıkıcı işlemler) kullanıldığı
    // için tek bir fonksiyona çıkarıldı. Genel bir rol sistemi değil,
    // sadece kullanicilar/{uid} belgesinde "yonetici: true" alanı olanlar.
    function yoneticiMi() {
      return request.auth != null &&
        get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.get('yonetici', false) == true;
    }

    // Uygulama içi bildirim merkezi — SADECE Cloud Functions (Admin SDK, bu
    // kurallara hiç tabi değil) yazabilir, bu yüzden "create" istemciden
    // tamamen kapalı (sahte bildirim oluşturmayı engellemek için). Sahibi
    // sadece "okunduMu" alanını değiştirebilir veya kendi bildirimini silebilir.
    match /bildirimler/{bildirimId} {
      allow read: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
      allow create: if false;
      allow update: if request.auth != null && resource.data.kullaniciId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['okunduMu']);
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    // Günlük Kayıtları (Diary) — bir eseri gerçekte ne zaman izlediğin/okuduğun
    // OLAYI, "eserPuanlarim"daki güncel puandan bağımsız (bkz. utils/gunluk.js
    // başındaki not). Sadece sahibi yazabilir/silebilir/güncelleyebilir;
    // okuma herkese açık (profildeki günlük sekmesi başkaları tarafından da
    // görülebilsin diye).
    match /gunlukKayitlari/{kayitId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
      // Kaydın sahibi her alanı güncelleyebilir (not düzenleme, tarih değiştirme vb.).
      // Başka bir giriş yapmış kullanıcı ise SADECE "begenenler" alanını
      // değiştirebilir — takip akışındaki beğeni butonu için (bkz.
      // gunlukBegenDegistir). "bildirimler" koleksiyonundaki aynı desenin eşi.
      allow update: if request.auth != null && (
        resource.data.kullaniciId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['begenenler'])
      );
    }

    // Eser/Kişi İstatistikleri: "Bizim Aramızda Popüler" listelerinin okuduğu
    // özet kayıtlar — her puan verildiğinde otomatik güncellenir (bkz.
    // eserIstatistik.js, kisiDegerlendirme.js). Kişi kendi yazdığı değil,
    // sistemin ürettiği bir özet olduğu için "write" pragmatik olarak
    // giriş yapmış herkese açık (kitaplar kataloğuyla aynı desen).
    match /eserIstatistikleri/{istatistikId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Film Müziği önbelleği — SADECE Cloud Function (Admin SDK, kurallara
    // tabi değil) yazabilir, istemciden "create/update" tamamen kapalı,
    // sahte veri girilmesini engellemek için.
    match /filmMuzikleri/{tmdbId} {
      allow read: if true;
      allow write: if false;
    }

    // Dizi Müziği önbelleği — filmMuzikleri ile aynı kural.
    match /diziMuzikleri/{tmdbId} {
      allow read: if true;
      allow write: if false;
    }

    // Platform katalog anlık görüntüsü — SADECE Cloud Function yazıyor
    // (dünle bugünü kıyaslamak için), istemciye hiç gösterilmiyor.
    match /platformKatalogSnapshot/{belgeId} {
      allow read: if false;
      allow write: if false;
    }

    // Platformlara yeni eklenenler — herkes okuyabilir (platform sayfasında
    // gösteriliyor), sadece Cloud Function yazabilir.
    match /platformYeniEklenenler/{belgeId} {
      allow read: if true;
      // Otomatik tespitler Cloud Function üzerinden (admin SDK, kurallara
      // tabi değil) yazılıyor. Elle ekleme için giriş yapmış herkese
      // create izni verildi — Haber Ekle ile aynı açıklık düzeyi.
      allow create: if request.auth != null;
      //
      // Delete önceden herkese açıktı — giriş yapmış HERHANGİ biri, otomatik
      // tespit edilenler dahil, TÜM veriyi silebilirdi. Şimdi: elle
      // ekleyen kendi kendi eklediğini silebilir (mükerrer/yanlış girişi
      // temizlemek için), otomatik tespit edilenleri (ekleyenId yok) ya da
      // başkasının eklediğini sadece yönetici silebilir.
      allow delete: if request.auth != null && (
        resource.data.ekleyenId == request.auth.uid || yoneticiMi()
      );
      allow update: if false;
    }

    // Film müziği beğenileri — kullanıcı kendi beğenisini ekleyip
    // kaldırabilir, herkes okuyabilir (profil sekmesi + anasayfa widget'ı).
    match /begenilenMuzikler/{begeniId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    // Dizi müziği beğenileri — begenilenMuzikler ile aynı kural, ayrı
    // koleksiyon (TMDB film/dizi ID çakışmasını önlemek için, bkz.
    // diziMuzigiBegeni.js).
    match /begenilenDiziMuzikleri/{begeniId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    // Müzik Tahmin oyununun iTunes önizleme önbelleği — herkes okuyup
    // yazabilir (sahte/zararlı veri riski yok, sadece bir önizleme URL'i).
    match /muzikOyunuOnizlemeleri/{tmdbId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /kisiIstatistikleri/{istatistikId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sanat Koleksiyonum: Sanat Eserleri Keşfet'te (Met/AIC) beğenilen eserlerin
    // kişisel koleksiyonu. Herkes görebilir (Poster Duvarı gibi), sadece sahibi
    // ekleyip silebilir.
    match /sanatKoleksiyonu/{kayitId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    // Kullanıcı profilleri: herkes okuyabilir, sadece kendi profilini oluşturup düzenleyebilir
    match /kullanicilar/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        // "uyeOlduklarim" ters indeksi (bkz. utils/topluluk.js) katılma isteği
        // ONAYLANDIĞINDA yöneticinin, başka bir kullanıcının kendi profiline bu
        // alanı yazması gerekiyor — sadece bu tek alanla sınırlı, güvenlik
        // kararı vermiyor (gerçek yetkilendirme hâlâ uyeler alt koleksiyonunda).
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uyeOlduklarim'])
      );

      // Takip ettiklerim: sadece ben kendi listeme yazabilirim
      match /takipEdilenler/{hedefUid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Beni takip edenler: doküman ID'si takip eden kişinin uid'si olduğu için
      // "başkasının profili altına yazıyor" gibi görünse de aslında herkes
      // sadece kendi adına (kendi uid'si ile) doküman oluşturabiliyor.
      match /takipciler/{takipciUid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == takipciUid;
      }

      // Push bildirim token'ları (FCM) — sadece hesap sahibi kendi
      // cihazlarının token'ını yazıp silebilir. Okumaya kimsenin ihtiyacı yok
      // dışarıdan (gönderme işlemi Cloud Functions'ta Admin SDK ile yapılıyor,
      // o da güvenlik kurallarına tabi değil), bu yüzden read de sahibe kapalı
      // tutulabilirdi ama debug kolaylığı için sahibine açık bırakıldı.
      match /bildirimTokenlari/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Davet kodları: herkes okuyabilir (kayıt öncesi doğrulama için),
    // sadece giriş yapmış kullanıcı kendi adına kod oluşturabilir,
    // kodu "tüketmek" (kullanildiMi=true yapmak) için update serbest bırakıldı —
    // Faz 1 için pragmatik bir seçim, ileride sıkılaştırılabilir.
    // Davet kodları: kayıt akışı, kullanıcı henüz giriş yapmadan tek bir kodu
    // (doküman ID'si = kodun kendisi) ID ile kontrol edebilmeli — bu yüzden
    // "get" (tekil okuma) herkese açık. Ama "list" (koleksiyonun TAMAMINI
    // sorgulama/listeleme) sadece giriş yapmış kullanıcılara açık — aksi hâlde
    // biri koleksiyonu doğrudan sorgulayıp tüm kullanılmamış kodları görebilir
    // ve daveti olmadan kayıt olabilirdi.
    match /davetKodlari/{kod} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.olusturanId == request.auth.uid;
      // Önceden herhangi bir giriş yapmış kullanıcı BAŞKASININ davet kodunu
      // (hatta toplu şekilde tüm kullanılmamış kodları) "kullanıldı" diye
      // işaretleyebilirdi — daveti sistemini kilitleyebilirdi. Şimdi sadece
      // kayıt akışındaki (kayitOl, AuthContext.jsx) tam olarak yaptığı şeye
      // izin veriliyor: kullanılmamış bir kodu, SADECE bu üç alanı
      // değiştirerek, kendi adına "kullanıldı" yapmak.
      allow update: if request.auth != null &&
        resource.data.kullanildiMi == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kullanildiMi', 'kullananId', 'kullanilmaTarihi']) &&
        request.resource.data.kullanildiMi == true &&
        request.resource.data.kullananId == request.auth.uid;
    }

    // Üyelik başvuruları: kimlik doğrulaması olmayan biri de başvurabilir
    // (henüz üye değil), ama listeyi sadece giriş yapmış üyeler görebilir
    // (spam/kişisel bilgi herkese açık olmasın diye). Onay/red durumu
    // güncellemesi de giriş yapmış herhangi bir üyeye açık — ayrı bir
    // "yönetici" rolü yok, akran onayı (peer-invite) mantığıyla çalışıyor.
    match /uyelikBasvurulari/{basvuruId} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }

    // Gönderiler (günceler): herkes okuyabilir, sadece kendi adına oluşturup silebilir.
    // "update" beğeni sayacı gibi ortak alanlar için serbest bırakıldı (Faz 1).
    // Serbest Düşünce Havuzu — Bilinç Akışı'nın günlük ortak tartışma
    // konusu kaynağı. Herkes okuyabilir, giriş yapmış herkes yeni konu
    // önerebilir (topluluğun havuzu büyütmesi için) — düzenleme/silme yok,
    // bir kez eklenen konu kalıcı.
    match /dusunceHavuzu/{konuId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Sadece yönetici uygunsuz/hatalı bir konuyu silebilir — genel bir
      // yönetici rolü sistemi değil, sadece bu tek hassas işlem için.
      allow delete: if yoneticiMi();
    }

    // Bir dönemin (gununKonulari) hangi konuya denk geldiğinin kalıcı
    // kaydı — arşivin güvenilirliği bu koleksiyonun asla değişmemesine
    // bağlı, o yüzden sadece "create" var, update/delete yok.
    match /gununKonulari/{tarih} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // İlham Panosu — üyelerin paylaştığı Instagram gönderileri.
    match /ilhamPanosu/{ilhamId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.paylasanId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.paylasanId == request.auth.uid;
      // Sahibi SADECE "paylasanAdi" alanını değiştirebilir — "Geçmişimi de
      // Güncelle" özelliği için (bkz. gecmisPaylasimlariGuncelle).
      allow update: if request.auth != null && resource.data.paylasanId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paylasanAdi']);
    }

    // Gezi Planları — sahip veya ortak düzenleyenler okuyup düzenleyebilir
    // (küçük, güvenilir bir topluluk için — kim ortak düzenleyici eklediğini
    // alan bazında ayırmıyoruz). Sadece sahip planı silebilir.
    match /geziPlanlari/{planId} {
      allow read, update: if request.auth != null &&
        (resource.data.sahipId == request.auth.uid || request.auth.uid in resource.data.ortakDuzenleyenler);
      allow delete: if request.auth != null && resource.data.sahipId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.sahipId == request.auth.uid;
    }

    // Meydan Okumalar — varsayılan özel: sadece sahip okuyup yazabilir.
    // herkeseAcik:true olanlar İSTİSNA olarak herkese okunabilir (profil
    // sayfasında başkalarının paylaştığı meydan okumaları göstermek için).
    match /meydanOkumalar/{moId} {
      allow read: if resource.data.herkeseAcik == true || (request.auth != null && resource.data.sahipId == request.auth.uid);
      allow update, delete: if request.auth != null && resource.data.sahipId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.sahipId == request.auth.uid;
    }

    match /gonderiler/{gonderiId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.yazarId == request.auth.uid;
      // Sahibi her alanı güncelleyebilir (düzenleme). Başka bir giriş yapmış
      // kullanıcı ise SADECE beğeni (begenenler) ve yorum sayacı
      // (yorumSayisi) alanlarını değiştirebilir — önceden bu kural
      // hiçbir kısıtlama içermiyordu, herkes başkasının paylaşımının
      // İÇERİĞİNİ değiştirebilirdi.
      allow update: if request.auth != null && (
        resource.data.yazarId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['begenenler', 'yorumSayisi'])
      );
      allow delete: if request.auth != null && resource.data.yazarId == request.auth.uid;
    }

    // Yorumlar: üst seviye koleksiyon (gonderiId alanıyla filtreleniyor) — hem bir
    // güncenin yorumlarını hem "Yorumlarım" profil sekmesini basit where() ile
    // sorgulayabilmek için.
    match /yorumlar/{yorumId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.yazarId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.yazarId == request.auth.uid;
      // Beğeni butonu için — herhangi bir giriş yapmış kullanıcı SADECE
      // "begenenler" alanını değiştirebilir (bildirimler/günlük
      // kayıtlarındaki aynı desen). Yazarın kendisi "yazarAdi" alanını
      // ("Geçmişimi de Güncelle" için) YA DA kendi yorumunun metnini
      // (düzenleme özelliği, duzenlendiMi/duzenlemeTarihi ile birlikte)
      // değiştirebilir — başka bir alanı değiştiremez.
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['begenenler']) ||
        (resource.data.yazarId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yazarAdi'])) ||
        (resource.data.yazarId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metin', 'duzenlendiMi', 'duzenlemeTarihi']))
      );
    }

    // Alıntı Duvarı: bir kitaptan beğenilen bir alıntının paylaşılması.
    // Sahibi her alanı güncelleyebilir. Başkası SADECE "begenenler" alanını
    // değiştirebilir — önceden hiçbir kısıtlama yoktu, herkes başkasının
    // paylaştığı alıntının metnini değiştirebilirdi.
    match /alintilar/{alintiId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.kullaniciId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['begenenler'])
      );
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    // Öne Çıkan Etkinlikler: Etkinlik.io'dan seçilen en fazla 3 etkinlik.
    // Herkes okuyabilir, giriş yapmış herkes ekleyip kaldırabilir (en fazla 3
    // sınırı istemci tarafında kontrol ediliyor — pragmatik, küçük topluluk).
    match /etkinlikOneCikanlar/{kayitId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Etkinlik Habercisi: ileriye dönük etkinlik duyuru panosu. Sahibi her
    // alanı güncelleyebilir. Başkası SADECE "katilacaklar" dizisini
    // değiştirebilir (katılım işareti) — önceden hiçbir kısıtlama yoktu.
    match /etkinlikHabercileri/{habercId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ekleyenId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['katilacaklar'])
      );
      allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
    }

    // İlgili Eserler: bir filmin uyarlandığı kitap gibi çift yönlü bağlantılar.
    // Herkes okuyabilir, giriş yapmış herkes ekleyip düzeltebilir (kitaplar
    // kataloğuyla aynı pragmatik desen).
    match /ilgiliEserler/{ilgiliId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sohbet: Oscar/Festival sezonuna özel hafif mesajlaşma. Herkes okuyabilir,
    // sadece kendi adına mesaj gönderebilir, düzenleme/silme yok (basit tutuldu).
    // Sohbet Mesajları: Oscar/Festival sezonları herkese açık kalıyor (eski
    // davranış). "topluluk_{id}" öneki taşıyan konumId'ler (topluluk sohbeti)
    // için ek olarak o topluluğun ÜYESİ olma şartı var — aksi halde herhangi
    // bir giriş yapmış kullanıcı herhangi bir topluluğun "özel" hissettiren
    // sohbetine yazabilirdi.
    match /sohbetMesajlari/{mesajId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid && (
        !request.resource.data.konumId.matches('^topluluk_.*') ||
        exists(/databases/$(database)/documents/topluluklar/$(request.resource.data.konumId.split('_')[1])/uyeler/$(request.auth.uid))
      );
    }

    // Festival Bölümü — Oscar Yolculuğu'yla aynı pragmatik desen: herkes
    // okuyabilir, giriş yapmış herkes sezon/film ekleyip düzenleyebilir.
    match /festivalSezonlari/{sezonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /festivalFilmleri/{filmId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /festivalBannerlari/{festivalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Oscar Yolculuğu (Faz 1) — sezon/kategori/aday referans verisi. Akademi'nin
    // resmi bir API'si olmadığı için elle giriliyor; küçük/davetli topluluk
    // olduğumuz için herkesin düzenleyebildiği pragmatik desen (bkz. kitaplar).
    match /oscarSezonlari/{sezonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /oscarKategorileri/{kategoriId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /oscarAdaylari/{adayId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Tahminler: sadece kendi tahminini yazabilirsin, VE sezon kilitliyse
    // (Faz 2'deki elle kilitleme) sunucu tarafında da reddedilir — sadece
    // arayüzde gizlemekle yetinmiyoruz.
    match /oscarTahminleri/{tahminId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.kullaniciId == request.auth.uid
        && get(/databases/$(database)/documents/oscarSezonlari/$(request.resource.data.sezonId)).data.get('kilitli', false) != true;
    }

    // Kişisel Listeler (Letterboxd tarzı, topluluklardaki ortak izleme
    // listesinden ayrı) — sahibi dışında kimse düzenleyemez/silemez;
    // "herkeseAcik: false" olan listeler sadece sahibine görünür.
    match /kisiselListeler/{listeId} {
      allow read: if resource.data.herkeseAcik == true || (request.auth != null && resource.data.kullaniciId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    match /kisiselListeOgeleri/{ogeId} {
      allow read: if true;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/kisiselListeler/$(request.resource.data.listeId)).data.kullaniciId == request.auth.uid;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/kisiselListeler/$(resource.data.listeId)).data.kullaniciId == request.auth.uid;
    }

    // Kitap Kataloğu (Faz 1) — Google Books + Open Library'den birleştirilip
    // kalıcı olarak yazılan dahili SSOT. Doküman ID'si Google Books volume ID'si
    // (mevcut favoriler/izlenecekler/eserPuanlari/gonderiler ile aynı disId şeması).
    // Herkes okuyabilir; sadece giriş yapmış kullanıcılar yazabilir (otomatik
    // doldurma sırasında). Faz 2'de kullanıcı düzenlemesi eklenince buradaki
    // "write" kuralı alan bazlı kısıtlamalarla sıkılaştırılacak.
    match /kitaplar/{kitapId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Faz 2 düzenleme geçmişi: kim, ne zaman, hangi alanı değiştirdi.
      // Kayıtlar değiştirilemez/silinemez (moderasyon/denetim izi olarak kalır).
      match /duzenlemeGecmisi/{kayitId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      }
    }

    // Favoriler ve İzleyecekler listesi: doküman ID'si `${uid}_${tur}_${disId}` olacak
    // şekilde sabit, bu yüzden "create" kuralında resource.data üzerinden kullaniciId
    // kontrolü yeterli; "update" gerekmiyor (setDoc ile üzerine yazılıyor, o da create
    // olarak değerlendirilir çünkü doküman içeriği tamamen değişiyor).
    match /favoriler/{favoriId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      // Önceden herkese açıktı — giriş yapmış herhangi biri başkasının
      // favorisini silebilirdi.
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    match /izlenecekler/{izlenecekId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      // "posterUrl" alanı için istisna: bir kitap/film sonradan düzenlenip
      // kapak eklendiğinde, TÜM kullanıcıların o esere ait kapaksız
      // "izleyecek/okuyorum" kayıtlarını doldurabilmek için (bkz.
      // izlenecekPosterleriniSenkronizeEt) — sadece bu tek alanla sınırlı.
      allow update: if request.auth != null && (
        request.resource.data.kullaniciId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['posterUrl'])
      );
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    // Kişi (yönetmen/oyuncu) değerlendirmeleri: doküman ID'si `${kisiTmdbId}_${uid}`
    // olduğu için her kullanıcı bir kişiye tek değerlendirme bırakabiliyor.
    match /kisiDegerlendirmeleri/{degerlendirmeId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
    }

    // Doğrudan eser puanlaması (günce yazmadan). Doküman ID'si `${tur}_${disId}_${uid}`.
    match /eserPuanlari/{puanId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
    }

    // Seyirdefteri Tavsiyeleri: film/dizi hub sayfalarında üyelerin öne çıkardığı eserler.
    match /tavsiyeler/{tavsiyeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
    }

    // Yeni Gelen Filmler: Anasayfa'da elle eklenen, "vizyona yeni giren" film şeridi.
    // Yapı olarak tavsiyeler ile birebir aynı, ayrı bir koleksiyonda tutuluyor ki
    // kişisel tavsiyelerle (tavsiyeler) karışmasın.
    match /yeniGelenFilmler/{filmId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
    }

    // Dijitalde Yeni Çıkanlar: Platformlar bölümünde elle eklenen, "artık
    // dijitalde/VOD'da izlenebilir" film şeridi — Yeni Gelen Filmler'den
    // (vizyona giriş) kavramsal olarak farklı bir aşama (dijitale düşüş),
    // bu yüzden ayrı bir koleksiyonda. Yapı birebir aynı.
    match /dijitalYeniCikanlar/{filmId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
    }

    // Yakında Gelecekler: "X filmi Y tarihinde Z platformuna/dijitale
    // geliyor" — geleceğe dönük duyuru. Çıkış tarihi geldiğinde bir Cloud
    // Function (yakindaGelenleriGecisYap) bunu otomatik olarak
    // platformYeniEklenenler ya da dijitalYeniCikanlar'a taşıyıp buradan
    // siliyor — admin SDK ile, kurallara tabi değil.
    match /yakindaGelecekler/{belgeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
    }

    // Haberler: Film/Dizi/Oyuncu bölümlerindeki kısa duyurular.
    match /haberler/{haberId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
    }

    // Kişisel okuma/izleme rafları — sadece sahibi oluşturup silebilir.
    match /raflar/{rafId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      // ogeSayisi güncellemesi de dahil, raflar kişisel olduğu için (başkası
      // asla bir başkasının rafına öge eklemiyor) sahiplik yeterli — önceden
      // herkese açıktı, herkes başkasının raf adını/açıklamasını değiştirebilirdi.
      allow update: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    match /rafOgeleri/{ogeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kullaniciId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.kullaniciId == request.auth.uid;
    }

    // Kitap İstekleri — "Şu kitabı arıyorum" panosu. Herkes okuyabilir,
    // sadece isteği açan güncelleyebilir/silebilir (kapatma dahil).
    match /kitapIstekleri/{istekId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.isteyenId == request.auth.uid;
      // v2: ödünç veren kişi isteyen DEĞİL — ama isteği güncelleyebilmesi
      // (oduncVerenId'yi kendi uid'sine ayarlaması, sonra "iade edildi"
      // işaretlemesi) gerekiyor. Kendini oduncVerenId olarak yazmasına ya da
      // zaten oduncVerenId oysa güncellemeye izin veriyoruz — başkasını
      // oduncVerenId diye işaretleyemez.
      allow update: if request.auth != null &&
        (resource.data.isteyenId == request.auth.uid ||
         request.resource.data.oduncVerenId == request.auth.uid ||
         resource.data.oduncVerenId == request.auth.uid);
      allow delete: if request.auth != null && resource.data.isteyenId == request.auth.uid;
    }

    // Yönetmenler: üyelerin elle eklediği küratörlü liste, doküman ID'si TMDB kişi ID'si.
    // Sinemasal Alt Türler (Korku Sineması, ileride Bilim Kurgu vb.) — hem
    // ana tür hem alt tür belgeleri sadece yönetici tarafından
    // eklenip/silinebiliyor (bkz. yoneticiMi()). Herkes okuyabilir, çünkü bu
    // menü yapısı sitenin genel keşif deneyiminin bir parçası.
    match /sinemaTurleri/{turId} {
      allow read: if true;
      allow create, delete: if yoneticiMi();
      allow update: if false;
    }

    match /sinemaAltTurleri/{altTurId} {
      allow read: if true;
      allow create, delete: if yoneticiMi();
      allow update: if false;
    }

    // Letterboxd'un resmi CSV dışa aktarma özelliğinden içe aktarılan
    // "En İyi 500 Film" listesi — sadece yönetici toplu olarak
    // ekleyip/silebilir (bkz. Letterboxd500IceAktar.jsx). update de
    // yöneticiye açık — aynı filmi (aynı doküman ID'si) tekrar
    // kaydetmek (batch.set) yarım kalan bir içe aktarmayı güvenle
    // sürdürebilmek için "create" değil "update" sayılıyor.
    // Dış film listeleri (Letterboxd 500, IMDb 250 vb.) — liste tanımı ve
    // alt koleksiyondaki her film sadece yönetici tarafından
    // eklenip/silinebiliyor (bkz. utils/disariListeler.js). Alt koleksiyon
    // kuralı üst belgenin match bloğunun İÇİNDE tanımlanıyor.
    match /disariListeler/{listeId} {
      allow read: if true;
      allow create, update, delete: if yoneticiMi();

      match /filmler/{tmdbId} {
        allow read: if true;
        allow create, update, delete: if yoneticiMi();
      }
    }

    match /yonetmenler/{tmdbId} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
      // Önceden herkese açıktı — giriş yapmış herhangi biri, kim eklemiş
      // olursa olsun, küratörlü listeden silebilirdi. Şimdi: ekleyen kendi
      // eklediğini silebilir, başkasınınkini sadece yönetici silebilir.
      allow delete: if request.auth != null && (resource.data.ekleyenId == request.auth.uid || yoneticiMi());

      match /ilgiliKitaplar/{kitapId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
      }
    }

    // Topluluklar: herkes okuyabilir, sadece kurucu adına oluşturulabilir.
    // "update": tam düzenleme kurucu VEYA moderatöre açık; üye olmayan herkes
    // için sadece "uyeSayisi" alanını değiştirmesine izin veriliyor (katıl/ayrıl
    // batch'i bunu yapıyor).
    match /topluluklar/{topluluklId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kurucuId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.kurucuId == request.auth.uid ||
        topluluklaYoneticiMi(topluluklId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uyeSayisi'])
      );
      allow delete: if request.auth != null && resource.data.kurucuId == request.auth.uid;

      // Üyeler: herkes rol/katılma tarihini görebilir. Katılma (create) ve ayrılma
      // (delete) herkes kendi kaydı için yapabilir; yönetici de bir üyeyi
      // çıkarabilir (delete). "rol" alanını (moderatör atama) SADECE kurucu,
      // ve sadece "rol" alanını değiştirerek güncelleyebilir.
      match /uyeler/{uyeUid} {
        allow read: if true;
        allow create: if request.auth != null && (
          topluluklaYoneticiMi(topluluklId) ||
          (request.auth.uid == uyeUid && get(/databases/$(database)/documents/topluluklar/$(topluluklId)).data.get('gizli', false) == false)
        );
        allow delete: if request.auth != null && (request.auth.uid == uyeUid || topluluklaYoneticiMi(topluluklId));
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/topluluklar/$(topluluklId)).data.kurucuId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol']);
      }

      // Katılma istekleri (kapalı/davetli topluluklar için) — isteği açan
      // kendi isteğini görüp iptal edebilir; kurucu/moderatör tüm istekleri
      // görüp onaylayabilir/reddedebilir (onaylama = uyeler'e yazıp isteği silme).
      match /istekler/{istekUid} {
        allow read: if request.auth != null && (request.auth.uid == istekUid || topluluklaYoneticiMi(topluluklId));
        allow create: if request.auth != null && request.auth.uid == istekUid;
        allow delete: if request.auth != null && (request.auth.uid == istekUid || topluluklaYoneticiMi(topluluklId));
      }

      // Topluluk listeleri (örn. "200 Film Serüveni") — sadece başlık/açıklama gibi
      // meta bilgi burada; öğeler artık üst seviye "listeOgeleri" koleksiyonunda (aşağıda).
      // Sadece üyeler liste açabilir. "update": tam düzenleme (başlık/kapak/açıklama)
      // sadece açan veya yöneticiye açık; "ogeSayisi" artışı (öğe eklerken) herkese
      // (üyeye) serbest.
      match /listeler/{listeId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.olusturanId == request.auth.uid
          && exists(/databases/$(database)/documents/topluluklar/$(topluluklId)/uyeler/$(request.auth.uid));
        allow update: if request.auth != null && (
          resource.data.olusturanId == request.auth.uid ||
          topluluklaYoneticiMi(topluluklId) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ogeSayisi'])
        );
        allow delete: if request.auth != null && (resource.data.olusturanId == request.auth.uid || topluluklaYoneticiMi(topluluklId));
      }
    }

    // Etkinlik Önerileri: üyelerin "sıradaki buluşmada bunu konuşalım" dediği
    // eserler, beğeni sayısına göre sıralanıyor. "update": beğenme herkese
    // (üyeye) açık — sadece "begenenler" alanı; öneriyi tam düzenlemek/silmek
    // sadece öneren veya yöneticiye açık.
    match /etkinlikOnerileri/{oneriId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.onerenId == request.auth.uid
        && exists(/databases/$(database)/documents/topluluklar/$(request.resource.data.topluluklId)/uyeler/$(request.auth.uid));
      allow update: if request.auth != null && (
        resource.data.onerenId == request.auth.uid ||
        topluluklaYoneticiMi(resource.data.topluluklId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['begenenler'])
      );
      allow delete: if request.auth != null && (
        resource.data.onerenId == request.auth.uid || topluluklaYoneticiMi(resource.data.topluluklId)
      );
    }

    // Gelecek Etkinlikler — üst seviye koleksiyon (topluluklId alanıyla filtreleniyor).
    // Hem topluluk sayfasında hem küresel Etkinlikler sayfasında collectionGroup
    // sorgusuna/özel indekse gerek kalmadan basit where() ile sorgulanabilsin diye.
    // "create": sadece o topluluğun ÜYESİ etkinlik ekleyebilir. "update"/"delete":
    // etkinliği açan VEYA topluluğun kurucusu/moderatörü tam düzenleyebilir;
    // diğer üyeler sadece "katilacaklar" (katılıyorum/vazgeçtim) alanını değiştirebilir.
    match /gelecekEtkinlikler/{etkinlikId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.olusturanId == request.auth.uid
        && exists(/databases/$(database)/documents/topluluklar/$(request.resource.data.topluluklId)/uyeler/$(request.auth.uid));
      allow update: if request.auth != null && (
        resource.data.olusturanId == request.auth.uid ||
        topluluklaYoneticiMi(resource.data.topluluklId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['katilacaklar'])
      );
      allow delete: if request.auth != null && (
        resource.data.olusturanId == request.auth.uid || topluluklaYoneticiMi(resource.data.topluluklId)
      );

      match /kaynaklar/{kaynakId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
      }
    }

    // Liste öğeleri (bir listedeki her film/dizi/kitap) — üst seviye koleksiyon
    // (topluluklId + listeId alanlarıyla filtreleniyor), aynı gerekçeyle.
    // "create": sadece o topluluğun ÜYESİ eser ekleyebilir. "update": tam düzenleme
    // (başlık/sıra/vb.) ekleyen VEYA yöneticiye açık; diğer üyeler sadece "puanlar"
    // ve "tamamlayanlar" (kendi puanı/tamamlama işareti) alanlarını değiştirebilir.
    match /listeOgeleri/{ogeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid
        && exists(/databases/$(database)/documents/topluluklar/$(request.resource.data.topluluklId)/uyeler/$(request.auth.uid));
      allow update: if request.auth != null && (
        resource.data.ekleyenId == request.auth.uid ||
        topluluklaYoneticiMi(resource.data.topluluklId) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puanlar', 'tamamlayanlar']) &&
          exists(/databases/$(database)/documents/topluluklar/$(resource.data.topluluklId)/uyeler/$(request.auth.uid))
        )
      );
      allow delete: if request.auth != null && (
        resource.data.ekleyenId == request.auth.uid || topluluklaYoneticiMi(resource.data.topluluklId)
      );
    }

    // Tartışma etkinlikleri ("bu film/kitap hakkında konuşalım")
    match /tartismaEtkinlikleri/{etkinlikId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.olusturanId == request.auth.uid;
      // Sahibi her alanı güncelleyebilir. Başkası SADECE "katilimcilar"
      // dizisini değiştirebilir (katıl/ayrıl) — önceden hiçbir kısıtlama yoktu.
      allow update: if request.auth != null && (
        resource.data.olusturanId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['katilimcilar'])
      );
      allow delete: if request.auth != null && resource.data.olusturanId == request.auth.uid;
    }
  }
}
