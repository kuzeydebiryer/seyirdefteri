rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profilleri: herkes okuyabilir, sadece kendi profilini oluşturup düzenleyebilir
    match /kullanicilar/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;

      // Takip ettiklerim: sadece ben kendi listeme yazabilirim
      match /takipEdilenler/{hedefUid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Beni takip edenler: doküman ID'si takip eden kişinin uid'si olduğu için
      // "başkasının profili altına yazıyor" gibi görünse de aslında herkes
      // sadece kendi adına (kendi uid'si ile) doküman oluşturabiliyor.
      match /takipciler/{takipciUid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == takipciUid;
      }
    }

    // Davet kodları: herkes okuyabilir (kayıt öncesi doğrulama için),
    // sadece giriş yapmış kullanıcı kendi adına kod oluşturabilir,
    // kodu "tüketmek" (kullanildiMi=true yapmak) için update serbest bırakıldı —
    // Faz 1 için pragmatik bir seçim, ileride sıkılaştırılabilir.
    match /davetKodlari/{kod} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.olusturanId == request.auth.uid;
      allow update: if request.auth != null;
    }

    // Gönderiler (günceler): herkes okuyabilir, sadece kendi adına oluşturup silebilir.
    // "update" beğeni sayacı gibi ortak alanlar için serbest bırakıldı (Faz 1).
    match /gonderiler/{gonderiId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.yazarId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.yazarId == request.auth.uid;

      match /yorumlar/{yorumId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.yazarId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.yazarId == request.auth.uid;
      }
    }

    // Topluluklar: herkes okuyabilir, sadece kurucu adına oluşturulabilir.
    // "update" (üye sayısı gibi ortak alanlar için) Faz 3'te pragmatik olarak serbest.
    match /topluluklar/{topluluklId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.kurucuId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.kurucuId == request.auth.uid;

      match /uyeler/{uyeUid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uyeUid;
      }

      // Gelecek Etkinlikler — topluluğun planladığı buluşmalar, katılım ve kaynak paylaşımı
      match /gelecekEtkinlikler/{etkinlikId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.olusturanId == request.auth.uid;
        allow update: if request.auth != null; // katilacaklar dizisi güncellemesi için serbest
        allow delete: if request.auth != null && resource.data.olusturanId == request.auth.uid;

        match /kaynaklar/{kaynakId} {
          allow read: if true;
          allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
          allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
        }
      }

      // Topluluk listeleri (örn. "200 Film Serüveni") — herkes okuyabilir,
      // giriş yapmış herkes liste oluşturup öğe/puan ekleyebilir.
      match /listeler/{listeId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.olusturanId == request.auth.uid;
        allow update: if request.auth != null; // ogeSayisi artışı için serbest
        allow delete: if request.auth != null && resource.data.olusturanId == request.auth.uid;

        match /ogeler/{ogeId} {
          allow read: if true;
          allow create: if request.auth != null && request.resource.data.ekleyenId == request.auth.uid;
          allow update: if request.auth != null; // puanlar map'ine kendi puanını eklemek için serbest
          allow delete: if request.auth != null && resource.data.ekleyenId == request.auth.uid;
        }
      }
    }

    // Tartışma etkinlikleri ("bu film/kitap hakkında konuşalım")
    match /tartismaEtkinlikleri/{etkinlikId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.olusturanId == request.auth.uid;
      allow update: if request.auth != null; // katılımcı listesi güncellemesi için serbest
      allow delete: if request.auth != null && resource.data.olusturanId == request.auth.uid;
    }
  }
}
